{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bochs GDB (Windows GDB -> Linux 10.200.65.1)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "OOS debug prep",
            "program": "${workspaceFolder}/targets/objs/kernel.exe",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "Z:\\UNIX V6++V1\\MinGW\\bin\\gdb.exe",
            "pipeTransport": {
                "pipeProgram": "${workspaceFolder}/tools/pipe-win-gdb.sh",
                "pipeCwd": "${workspaceFolder}",
                "debuggerPath": "Z:\\UNIX V6++V1\\MinGW\\bin\\gdb.exe"
            },
            "targetArchitecture": "x86",
            "sourceFileMap": {
                "Z:\\UNIX V6++V1\\oos": "${workspaceFolder}",
                "Z:/UNIX V6++V1/oos": "${workspaceFolder}",
                "../include": "${workspaceFolder}/src/include",
                "../../include": "${workspaceFolder}/src/include",
                "Allocator.cpp": "${workspaceFolder}/src/mm/Allocator.cpp",
                "ATADriver.cpp": "${workspaceFolder}/src/dev/ATADriver.cpp",
                "BlockDevice.cpp": "${workspaceFolder}/src/dev/BlockDevice.cpp",
                "BufferManager.cpp": "${workspaceFolder}/src/dev/BufferManager.cpp",
                "CharDevice.cpp": "${workspaceFolder}/src/dev/CharDevice.cpp",
                "Chip8253.cpp": "${workspaceFolder}/src/machine/Chip8253.cpp",
                "Chip8259A.cpp": "${workspaceFolder}/src/machine/Chip8259A.cpp",
                "CMOSTime.cpp": "${workspaceFolder}/src/machine/CMOSTime.cpp",
                "CRT.cpp": "${workspaceFolder}/src/tty/CRT.cpp",
                "DeviceManager.cpp": "${workspaceFolder}/src/dev/DeviceManager.cpp",
                "DiskInterrupt.cpp": "${workspaceFolder}/src/interrupt/DiskInterrupt.cpp",
                "DMA.cpp": "${workspaceFolder}/src/dev/DMA.cpp",
                "Exception.cpp": "${workspaceFolder}/src/interrupt/Exception.cpp",
                "File.cpp": "${workspaceFolder}/src/fs/File.cpp",
                "FileManager.cpp": "${workspaceFolder}/src/fs/FileManager.cpp",
                "FileSystem.cpp": "${workspaceFolder}/src/fs/FileSystem.cpp",
                "GDT.cpp": "${workspaceFolder}/src/machine/GDT.cpp",
                "IDT.cpp": "${workspaceFolder}/src/machine/IDT.cpp",
                "INode.cpp": "${workspaceFolder}/src/fs/INode.cpp",
                "Kernel.cpp": "${workspaceFolder}/src/kernel/Kernel.cpp",
                "KernelAllocator.cpp": "${workspaceFolder}/src/mm/KernelAllocator.cpp",
                "Keyboard.cpp": "${workspaceFolder}/src/tty/Keyboard.cpp",
                "KeyboardInterrupt.cpp": "${workspaceFolder}/src/interrupt/KeyboardInterrupt.cpp",
                "Lib.cpp": "${workspaceFolder}/src/test/lib/Lib.cpp",
                "Machine.cpp": "${workspaceFolder}/src/machine/Machine.cpp",
                "main.cpp": "${workspaceFolder}/src/kernel/main.cpp",
                "MemoryDescriptor.cpp": "${workspaceFolder}/src/proc/MemoryDescriptor.cpp",
                "New.cpp": "${workspaceFolder}/src/mm/New.cpp",
                "OpenFileManager.cpp": "${workspaceFolder}/src/fs/OpenFileManager.cpp",
                "PageDirectory.cpp": "${workspaceFolder}/src/machine/PageDirectory.cpp",
                "PageManager.cpp": "${workspaceFolder}/src/mm/PageManager.cpp",
                "PEParser.cpp": "${workspaceFolder}/src/pe/PEParser.cpp",
                "Process.cpp": "${workspaceFolder}/src/proc/Process.cpp",
                "ProcessManager.cpp": "${workspaceFolder}/src/proc/ProcessManager.cpp",
                "support.c": "${workspaceFolder}/src/boot/support.c",
                "SwapperManager.cpp": "${workspaceFolder}/src/mm/SwapperManager.cpp",
                "SystemCall.cpp": "${workspaceFolder}/src/interrupt/SystemCall.cpp",
                "TaskStateSegment.cpp": "${workspaceFolder}/src/machine/TaskStateSegment.cpp",
                "TestBufferManager.cpp": "${workspaceFolder}/src/test/dev/TestBufferManager.cpp",
                "TestFileSystem.cpp": "${workspaceFolder}/src/test/fs/TestFileSystem.cpp",
                "TestLib.cpp": "${workspaceFolder}/src/test/lib/TestLib.cpp",
                "TestSwapperManager.cpp": "${workspaceFolder}/src/test/mm/TestSwapperManager.cpp",
                "TestUtility.cpp": "${workspaceFolder}/src/test/TestUtility.cpp",
                "Text.cpp": "${workspaceFolder}/src/proc/Text.cpp",
                "TimeInterrupt.cpp": "${workspaceFolder}/src/interrupt/TimeInterrupt.cpp",
                "TTy.cpp": "${workspaceFolder}/src/tty/TTy.cpp",
                "User.cpp": "${workspaceFolder}/src/proc/User.cpp",
                "Utility.cpp": "${workspaceFolder}/src/kernel/Utility.cpp",
                "Video.cpp": "${workspaceFolder}/src/kernel/Video.cpp"
            },
            "stopAtEntry": true,
            "externalConsole": false,
            "launchCompleteCommand": "None",
            "customLaunchSetupCommands": [
                {
                    "description": "Load kernel symbols from Windows shared path",
                    "text": "-file-exec-and-symbols \"Z:\\\\UNIX V6++V1\\\\oos\\\\targets\\\\objs\\\\kernel.exe\"",
                    "ignoreFailures": false
                },
                {
                    "description": "Connect Windows GDB to Linux gdbstub",
                    "text": "-target-select remote 10.200.65.1:1234",
                    "ignoreFailures": false
                }
            ],
            "logging": {
                "engineLogging": true
            },
            "setupCommands": [
                {
                    "description": "Use Intel disassembly syntax",
                    "text": "set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Add kernel source directories",
                    "text": "directory src/boot src/dev src/fs src/include src/interrupt src/kernel src/lib src/machine src/mm src/pe src/proc src/test src/tty",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
