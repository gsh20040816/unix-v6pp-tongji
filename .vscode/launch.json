                },
                {
                    "description": "Remove previous user symbol at fixed user text base (if any)",
                    "text": "remove-symbol-file -a 0x00401000",
                    "ignoreFailures": true
                },
                {
                    "description": "Load selected user program symbols at user text base",
                    "text": "add-symbol-file ${workspaceFolder}/build/fs-payload/programs${input:userSymbolPathFromFsRoot} 0x00401000",
                    "ignoreFailures": false
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "userSymbolPathFromFsRoot",
            "type": "promptString",
            "description": "用户态程序虚拟路径（文件系统根目录路径，例如 /Shell 或 /bin/ls）",
            "default": "/bin/ls"
        }
    ]
