{
    "tasks": [
        {
            "type": "shell",
            "label": "OOS make",
            "command": "bash",
            "args": [
                "-lc",
                "./build.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "在 Linux 工作区中触发 build.sh，并通过 SSH 到 Windows 完成构建",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "OOS debug prep",
            "dependsOrder": "sequence",
            "dependsOn": [
                "OOS make",
                "OOS linux debug host"
            ]
        },
        {
            "type": "shell",
            "label": "OOS linux debug host",
            "command": "bash",
            "args": [
                "-lc",
                "./debug.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "在 Linux 本机启动 bochs-gdb，并等待 gdbstub 可连接",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "clear": false
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^(?!)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Starting bochs-gdb in .*",
                    "endsPattern": ".*Enabled gdbstub.*"
                }
            }
        }
    ],
    "version": "2.0.0"
}
