{
    "tasks": [
		{
			"type": "shell",
			"label": "cmake/configure",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 配置构建目录",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "cmake/build",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"image",
				"-j"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 构建内核与用户程序并生成 c.img",
			"dependsOrder": "sequence",
			"dependsOn": [
				"cmake/configure"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "cmake/clean",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 清理构建产物与磁盘镜像",
			"dependsOrder": "sequence",
			"dependsOn": [
				"cmake/configure"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "bochs/run",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"bochs",
				"-j"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 启动 bochs（nodebug 配置）",
			"dependsOrder": "sequence",
			"dependsOn": [
				"cmake/build"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "bochs/debug",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"bochs-gdb",
				"-j"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 启动 bochs-gdb 并等待 gdbstub 可连接",
			"dependsOrder": "sequence",
			"dependsOn": [
				"cmake/build"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^(?!)$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": ".*Enabled gdbstub.*"
				}
			}
		},
		{
			"type": "shell",
			"label": "bochs/gui",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"bochsrc_gui",
				"-j"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机通过 CMake 启动 bochs（gui 配置）",
			"dependsOrder": "sequence",
			"dependsOn": [
				"cmake/build"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "qemu/run",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"qemu",
