{
    "tasks": [
		{
			"type": "shell",
			"label": "OOS make",
			"command": "make",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机构建内核与用户程序，并生成 c.img",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "OOS clean",
			"command": "make",
			"args": [
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "清理 Linux 本机构建产物与磁盘镜像",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "OOS make prelaunch",
			"command": "make",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "调试前静默构建",
			"presentation": {
				"reveal": "never",
				"panel": "shared",
				"focus": false,
				"showReuseMessage": false,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "OOS debug prep",
			"dependsOrder": "sequence",
			"dependsOn": [
				"OOS make prelaunch",
				"OOS linux debug host"
			]
		},
		{
			"type": "shell",
			"label": "OOS linux debug host",
			"command": "make",
			"args": [
				"bochs-gdb"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在 Linux 本机启动 bochs-gdb，并等待 gdbstub 可连接",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^(?!)$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*Starting bochs-gdb in .*",
					"endsPattern": ".*Enabled gdbstub.*"
				}
			}
		},
		{
			"type": "shell",
			"label": "OOS run bochs",
			"command": "bochs-gdb",
			"args": [
				"-q",
				"-f",
				"bochsrc_nodebug.bxrc"
			],
			"options": {
				"cwd": "${workspaceFolder}/targets/UNIXV6++"
			},
			"detail": "在 Linux 本机启动 bochs，不调试",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": false
			},
			"problemMatcher": []
		}
	],
    "version": "2.0.0"
}
