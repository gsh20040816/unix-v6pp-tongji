# Kernel/user build outputs. Keep runtime configs under targets/UNIXV6++.
targets/img/
targets/objs/
targets/UNIXV6++/c.img
targets/UNIXV6++/c.img.lock
targets/UNIXV6++/bochsout.txt

# In-tree program/library build outputs.
src/lib/*.a
src/lib/objs/
src/program/objs/
src/shell/OBJS/

# Shared VS Code workflow files can stay tracked.
# Ignore only generated indexes, logs, and machine-local compiler settings.
.vscode/.cache/
.vscode/compile_commands.json
.vscode/configurationCache.log
.vscode/dryrun.log
.vscode/make-dryrun-full.log
.vscode/targets.log
.vscode/c_cpp_properties.json

# Tool-side generated outputs and temporary workspaces.
tools/v6pp-fs-edit-2022/workspace/
tools/v6pp-fs-edit-2022/src/**/objs/

# OS noise.
.DS_Store
